within SafetyAssessmentLibrary;
package TimeWindows "W: objective time domains"
  extends Modelica.Icons.Package;
  annotation(Icon(coordinateSystem(extent={{-100,-100},{100,100}}), graphics={Rectangle(extent={{-100,100},{100,-100}}, lineColor={105,75,155}, fillColor={242,236,250}, fillPattern=FillPattern.Solid), Text(extent={{-88,30},{88,-30}}, textString="Time\nWindows", textColor={80,55,125})}), Documentation(info="<html><p>Every W component answers only whether the current instant belongs to the objective domain and returns one typed WindowState.</p></html>"));
end TimeWindows;