within SafetyAssessmentLibrary;
package Results "Safety conclusion and read-only reporting"
  extends Modelica.Icons.Package;
  annotation(Documentation(info="<html><p>The public Q layer contains one semantic resolver, <code>SafetyResult</code>, and one optional console observer. Lifecycle, grade, verdict, Top Event, and evidence remain distinct fields in the structured result.</p></html>"));
end Results;