within SafetyAssessmentLibrary;
package Examples "Independent A assets and executable NISSA Scenarios"
  extends Modelica.Icons.ExamplesPackage;
  annotation(Documentation(info="<html><p><b>Organization:</b> Systems contains connector-free coupled M/M_F behavior; Assessments contains three independent input-only white-box A models; Scenarios contains the main multi-objective composition.</p><p><b>NISSA relation:</b> S=M/M_F+ObservationBinding+one or more A, and R is the set of compact records produced by those assessments.</p></html>"));
end Examples;
