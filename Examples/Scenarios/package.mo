within SafetyAssessmentLibrary.Examples;
package Scenarios "Executable NISSA Scenarios S=M/M_F+bindings+one or more A"
  extends Modelica.Icons.ExamplesPackage;
  annotation(Documentation(info="<html><p>A Scenario owns behavioral assets and explicit observation bindings, then attaches one or more independent assessment assets. The Scenario itself has no signal connector. Its result set is R={A1.result,A2.result,...}.</p></html>"));
end Scenarios;
